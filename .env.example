# ==============================================================
# TELEGRAM BOT & SUPABASE POSTGRESQL ENVIRONMENT CONFIGURATION
# ==============================================================

# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# Asosiy Bosh Administrator Telegram ID (raqam)
ADMIN_ID=8039427064

# Bot username (masalan: demo_rashonatili_bot)
BOT_USERNAME=demo_rashonatili_bot

# WebApp va Veb-server porti (Render yoki lokal)
PORT=8082

# Mini App / WebApp ommaviy URL manzili
WEBAPP_URL=https://ona-tili-bot.onrender.com

# Webhook rejimi (1 = Webhook yoqilgan, 0 = Polling)
USE_WEBHOOK=1
WEBHOOK_SECRET=your_random_secure_webhook_secret_here

# Redis FSM Storage URL (ixtiyoriy, berilsa holatlar saqlanadi: rediss://... yoki redis://...)
REDIS_URL=

# Supabase PostgreSQL Connection Pooler URL (IPv4 / PgBouncer - port 6543 yoki 5432)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_strong_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google Gemini API kaliti (Javoblar varaqasi AI OCR skaneri uchun)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Connection Pool sozlamalari (10,000+ so'rovlar uchun)
PG_POOL_MINCONN=1
PG_POOL_MAXCONN=25
